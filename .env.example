# Frontend URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# Backend URL (Spring Boot)
BACKEND_API_URL=http://localhost:8080

# Google Identity Services OAuth Client ID (public, dùng cho đăng ký khách hàng bằng Google)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Chế độ Mock API (true | false)
USE_MOCK_API=false
